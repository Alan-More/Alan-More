# Alan-More Environment Variables
#
# IMPORTANT: This file is for reference only.
# DO NOT add actual secrets here.
#
# Secrets are configured through Claude Platform Credential Vaults:
# https://platform.claude.com/workspaces/default/credential-vaults

# ============================================================================
# Vercel AI Gateway (Jev Integration)
# ============================================================================
#
# This key is stored securely in Claude Platform Credential Vaults.
# It is automatically injected into Claude Code sessions.
#
# Configured in: Credential Vaults > Vercel AI Gateway
# Variable Name: AI_GATEWAY_API_KEY
# Auth Type: Environment variable
#
# DO NOT set this manually in .env or commit it to Git
#
# AI_GATEWAY_API_KEY=sk_gateway_xxxxx

# ============================================================================
# Anthropic API (Standard Claude Usage)
# ============================================================================
#
# Claude Code handles this automatically.
# The default ANTHROPIC_BASE_URL is: https://api.anthropic.com
#
# For local testing, you can optionally set:
# ANTHROPIC_API_KEY=sk_ant_xxxxx
#
# But this is NOT required for Claude Code cloud sessions.
#
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk_ant_xxxxx

# ============================================================================
# Application Configuration
# ============================================================================

NODE_ENV=development
# NODE_ENV=production

# Debug logging
DEBUG=false
# DEBUG=alan-more:*

# Model preferences
DEFAULT_MODEL=claude-opus-5-5
# DEFAULT_MODEL=claude-sonnet-5-5

# API timeouts (in milliseconds)
API_TIMEOUT=30000

# ============================================================================
# Developer Notes
# ============================================================================
#
# 1. AI_GATEWAY_API_KEY Setup:
#    - Go to: https://platform.claude.com/workspaces/default/credential-vaults
#    - Create/manage credential vaults
#    - The key is automatically injected into new Claude Code sessions
#    - It persists across sessions (no need to reconfigure)
#
# 2. For local development:
#    - Copy this file to .env.local
#    - Add your ANTHROPIC_API_KEY for testing
#    - Never commit actual keys to Git
#    - Update .gitignore to exclude .env.local
#
# 3. For production:
#    - Use only Claude Platform Credential Vaults
#    - Never set secrets in environment files
#    - All secrets are managed server-side
#
# 4. Security best practices:
#    - Always use https://api.gateway.vercel.com for Jev
#    - Always use https://api.anthropic.com for regular Claude
#    - Never log secrets
#    - Never expose API keys in error messages
