# Alan-More Environment Variables
#
# IMPORTANT: This file is for reference only.
# Secrets are configured through Claude Platform Credential Vaults.

# Vercel AI Gateway (Jev Integration)
# Claude Code cloud: add an API credential (Bearer, website ai-gateway.vercel.sh)
#   in the environment settings. The proxy injects the Authorization header,
#   so AI_GATEWAY_API_KEY stays unset there.
# Local dev: set AI_GATEWAY_API_KEY yourself (never commit it).
#
# AI_GATEWAY_API_KEY=vck_xxxxx
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
# JEV_MODEL=anthropic/claude-opus-5.5

# Anthropic API (Standard Claude Usage)
# Claude Code handles this automatically
# Default: https://api.anthropic.com
#
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk_ant_xxxxx (optional for local dev)

# Application Configuration
NODE_ENV=development
DEBUG=false
DEFAULT_MODEL=claude-opus-5-5
API_TIMEOUT=30000
