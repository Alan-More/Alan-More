# Alan-More Environment Variables
#
# IMPORTANT: This file is for reference only.
# Secrets are configured through Claude Platform Credential Vaults.

# Vercel AI Gateway (Jev Integration)
# Stored in: Claude Platform → Credential Vaults → Vercel AI Gateway
# Variable Name: AI_GATEWAY_API_KEY
# DO NOT set this manually - it's auto-injected into Claude Code sessions
#
# AI_GATEWAY_API_KEY=sk_gateway_xxxxx

# Anthropic API
# Not needed by the app: structured and regular decisions both use the gateway.
# Only createStandardAnthropicClient() (unused by default) reads these.
#
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk_ant_xxxxx

# Claude Code cloud sessions: route Node requests through the session proxy
# NODE_USE_ENV_PROXY=1

# Application Configuration
NODE_ENV=development
DEBUG=false
DEFAULT_MODEL=anthropic/claude-opus-5-5
API_TIMEOUT=30000
